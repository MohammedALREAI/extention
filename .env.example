# Copy to .env and fill in. Nothing here has a default in code: a missing value fails
# loudly rather than silently reaching somewhere nobody chose.

# --- Database (required) -----------------------------------------------------
# MySQL 8 connection string. The extension API reads the user, subscription and
# policy rows on every call, so without this every request answers 401.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/content_firewall

# --- Session signing (required) ----------------------------------------------
# Signs both the login cookie and the extension access token. Any long random
# string; changing it invalidates every issued extension snapshot.
JWT_SECRET=replace-with-a-long-random-string
# Optional migration target for extension semantic and visual requests.
# Leave empty to keep using the Node extension API.
CF_PYTHON_API_URL=http://127.0.0.1:8000
# Recommended separate secret for the Python extension-token verifier.
# During migration it must match the Node signing secret.
CF_EXTENSION_TOKEN_SECRET=replace-with-the-same-long-random-string

# --- Model gateway (required for any detection) ------------------------------
# Any OpenAI-compatible endpoint exposing /v1/chat/completions and /v1/models.
# Give the base URL only — no /v1, no trailing slash. Examples:
#   https://api.openai.com          (key from platform.openai.com)
#   https://openrouter.ai/api       (Gemini and Claude in one catalog)
BUILT_IN_FORGE_API_URL=https://your-gateway.example.com
BUILT_IN_FORGE_API_KEY=

# Model names differ per provider. Leave these unset to use the built-in defaults
# (Gemini/Claude names); set them to whatever your provider actually lists, or the
# route fails with a message naming the ids it looked for and the ones available.
# The visual route needs a model that accepts images.
#   OpenAI:     CF_MODEL_VISUAL=gpt-4o   CF_MODEL_SEMANTIC=gpt-4o-mini
#   OpenRouter: CF_MODEL_VISUAL=google/gemini
CF_MODEL_VISUAL=
CF_MODEL_SEMANTIC=
CF_MODEL_MODERATION=

# --- Local port --------------------------------------------------------------
PORT=3001

# --- OAuth (only needed to sign in through the web app) ----------------------
# The local seed script creates a user directly, so these can stay empty while
# testing the extension.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- Dev scripts -------------------------------------------------------------
# Sample image used by scripts/check_visual_localization.ts and friends.
CF_TEST_IMAGE_URL=
