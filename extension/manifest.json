{
  "manifest_version": 3,
  "name": "Content Firewall — Search Guard",
  "version": "1.0.9",
  "description": "Multilingual AI protection that masks matching text and objects in search results.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.manus.space/*", "https://*.manus.computer/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Content Firewall — protected items",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["policy.js", "engines.js", "contentHelpers.js", "contentRuntime.js", "contentStartup.js", "visibilityScheduler.js", "performanceMetrics.js", "requestControl.js", "workScheduler.js", "imageSource.js", "semanticClient.js", "visualClient.js", "contentFlow.js", "textMask.js", "feedback.js", "imageMask.js", "strictImageFlow.js", "imageDecisionPipeline.js", "imageFlow.js", "decisionExplanation.js", "contentPipeline.js", "contentCount.js", "contentCleanup.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
