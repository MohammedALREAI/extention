# Copy values into the environment used by uvicorn. Do not commit real secrets.
CF_ENV=development

# Must match the Node service when the extension uses Python endpoints.
CF_EXTENSION_TOKEN_SECRET=local-dev-secret

# Required at boot. Use a real OpenAI-compatible model gateway for analysis.
BUILT_IN_FORGE_API_URL=http://127.0.0.1:9
BUILT_IN_FORGE_API_KEY=local-dev-key
CF_MODEL_SEMANTIC=
CF_MODEL_VISUAL=
CF_MODEL_MODERATION=

# Required for authenticated policy resolution. The local compose file provides this database.
DATABASE_URL=postgresql+asyncpg://contentfirewall:contentfirewall@127.0.0.1:5433/contentfirewall
REDIS_URL=redis://127.0.0.1:6380/0

# Local-only escape hatch. Never use this in production.
CF_DEV_NO_AUTH=1
